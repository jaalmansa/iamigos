#!/usr/bin/env python3
"""IAmigos — Claude Code hook.

Reads the event JSON from stdin, turns it into a state and writes it to
$XDG_STATE_HOME/iamigos/sessions/claude-<session_id>.json (atomically), with
~/.local/state as the default on every platform (Linux, macOS and Windows).

It must never break the session: any error is ignored and it exits with 0,
without writing anything to stdout (Claude Code reads the stdout of some hooks).
"""
import json
import os
import re
import subprocess
import sys
import time

STATE_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
    "iamigos",
    "sessions",
)

# Tools that mean "it is asking you something".
ASKING_TOOLS = {"AskUserQuestion", "ExitPlanMode"}


def map_event(ev, prev_state):
    """Returns (state, detail), or (None, None) if the event changes nothing."""
    name = ev.get("hook_event_name", "")
    tool = ev.get("tool_name") or ""

    if name == "SessionStart":
        return "idle", ev.get("source", "")
    if name == "UserPromptSubmit":
        return "working", ""
    if name == "PreToolUse":
        if tool in ASKING_TOOLS:
            return "asking", tool
        return "working", tool
    if name in ("PostToolUse", "PostToolUseFailure", "PermissionDenied", "SubagentStart", "PostCompact"):
        return "working", tool
    if name == "PermissionRequest":
        return "permission", tool
    if name == "Notification":
        kind = ev.get("notification_type", "")
        if kind == "permission_prompt":
            return "permission", ev.get("message", "")
        if kind == "elicitation_dialog":
            return "asking", ev.get("message", "")
        return None, None  # idle_prompt, auth_success…: the extension handles sleeping
    if name == "PreCompact":
        return "compacting", ev.get("trigger", "")
    if name == "Stop":
        return "done", ""
    if name == "StopFailure":
        return "error", str(ev.get("error") or ev.get("message") or "")[:200]
    if name == "SessionEnd":
        return "closed", ev.get("reason", "")
    return None, None


def context_usage(transcript_path):
    """(tokens, model) of the main agent's last response in the transcript.

    The context in use is what went into that request: input + cache read + cache created.
    Only the end of the file is read, as it can be large.
    """
    if not transcript_path:
        return None, None
    try:
        with open(transcript_path, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - 512 * 1024))
            lines = f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return None, None
    for line in reversed(lines):
        if '"usage"' not in line:
            continue
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if entry.get("isSidechain"):
            continue
        msg = entry.get("message") or {}
        usage = msg.get("usage") or {}
        if not usage:
            continue
        tokens = (usage.get("input_tokens", 0) + usage.get("cache_read_input_tokens", 0)
                  + usage.get("cache_creation_input_tokens", 0))
        return tokens, msg.get("model")
    return None, None


def project_name(cwd):
    """Name of the project folder (Linux, macOS and Windows paths)."""
    name = re.split(r"[\\/]", cwd.rstrip("/\\"))[-1] if cwd else ""
    return name or "?"


def update_subagents(name, ev, prev_list):
    """List of live subagents: [{id, type, since}]."""
    if name in ("SessionStart", "SessionEnd"):
        return []
    subs = [s for s in (prev_list or []) if isinstance(s, dict)]
    agent_id = ev.get("agent_id")
    if name == "SubagentStart" and agent_id and not any(s.get("id") == agent_id for s in subs):
        subs.append({"id": agent_id, "type": ev.get("agent_type") or "", "since": time.time()})
    elif name == "SubagentStop" and agent_id:
        subs = [s for s in subs if s.get("id") != agent_id]
    return subs


def mux_info():
    """Where the session lives inside zellij/tmux, so the extension can jump to its pane."""
    env = os.environ
    if env.get("ZELLIJ_SESSION_NAME") and env.get("ZELLIJ_PANE_ID"):
        return {"kind": "zellij", "session": env["ZELLIJ_SESSION_NAME"], "pane": env["ZELLIJ_PANE_ID"]}
    if env.get("TMUX") and env.get("TMUX_PANE"):
        return {"kind": "tmux", "socket": env["TMUX"].split(",")[0], "pane": env["TMUX_PANE"]}
    return None


def term_info(agent_pid):
    """Which terminal tab/pane the session lives in, for terminals that can focus one:
    its TTY (macOS Terminal.app and iTerm2 find the tab by it), WezTerm's pane and
    kitty's window."""
    env = os.environ
    term = {}
    if env.get("WEZTERM_PANE"):
        term["wezterm_pane"] = env["WEZTERM_PANE"]
    if env.get("KITTY_WINDOW_ID"):
        term["kitty_window"] = env["KITTY_WINDOW_ID"]
        if env.get("KITTY_LISTEN_ON"):
            term["kitty_listen"] = env["KITTY_LISTEN_ON"]
    if sys.platform == "darwin" and agent_pid:
        try:
            tty = subprocess.run(["ps", "-o", "tty=", "-p", str(agent_pid)], capture_output=True,
                                 text=True, timeout=2).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            tty = ""
        if tty and tty not in ("?", "??"):
            term["tty"] = tty if tty.startswith("/dev/") else "/dev/" + tty
    return term or None


def _proc_linux(pid):
    """(name, exe, parent pid) of a process, from /proc."""
    try:
        exe = os.readlink(f"/proc/{pid}/exe")
    except OSError:
        exe = ""
    try:
        with open(f"/proc/{pid}/comm") as f:
            comm = f.read().strip()
    except OSError:
        comm = ""
    try:
        with open(f"/proc/{pid}/stat") as f:
            # the comm field may contain spaces: split after the last ')'
            ppid = int(f.read().rsplit(")", 1)[1].split()[1])
    except (OSError, ValueError, IndexError):
        ppid = 0
    return comm, exe, ppid


def _proc_darwin(pid):
    """(name, exe, parent pid) of a process, from ps (macOS has no /proc)."""
    import subprocess
    try:
        out = subprocess.run(["ps", "-o", "ppid=,comm=", "-p", str(pid)],
                             capture_output=True, text=True, timeout=2).stdout.strip()
        ppid, comm = out.split(None, 1)
        return os.path.basename(comm), comm, int(ppid)
    except (OSError, ValueError, subprocess.SubprocessError):
        return "", "", 0


def _windows_processes():
    """{pid: (exe name, parent pid)} of every process, with the Toolhelp API."""
    import ctypes
    from ctypes import wintypes

    class PROCESSENTRY32W(ctypes.Structure):
        _fields_ = [
            ("dwSize", wintypes.DWORD), ("cntUsage", wintypes.DWORD),
            ("th32ProcessID", wintypes.DWORD), ("th32DefaultHeapID", ctypes.c_size_t),
            ("th32ModuleID", wintypes.DWORD), ("cntThreads", wintypes.DWORD),
            ("th32ParentProcessID", wintypes.DWORD), ("pcPriClassBase", ctypes.c_long),
            ("dwFlags", wintypes.DWORD), ("szExeFile", ctypes.c_wchar * 260),
        ]

    kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
    kernel32.CreateToolhelp32Snapshot.restype = wintypes.HANDLE
    snap = kernel32.CreateToolhelp32Snapshot(0x2, 0)  # TH32CS_SNAPPROCESS
    if not snap or snap == wintypes.HANDLE(-1).value:
        return {}
    procs = {}
    try:
        entry = PROCESSENTRY32W()
        entry.dwSize = ctypes.sizeof(PROCESSENTRY32W)
        ok = kernel32.Process32FirstW(snap, ctypes.byref(entry))
        while ok:
            procs[entry.th32ProcessID] = (entry.szExeFile, entry.th32ParentProcessID)
            ok = kernel32.Process32NextW(snap, ctypes.byref(entry))
    finally:
        kernel32.CloseHandle(snap)
    return procs


def proc_reader(platform=sys.platform):
    """A function pid → (name, exe, parent pid) for this platform."""
    if platform == "darwin":
        return _proc_darwin
    if platform == "win32":
        procs = _windows_processes()

        def read(pid):
            name, ppid = procs.get(pid, ("", 0))
            return name, name, ppid
        return read
    return _proc_linux


def find_agent_pid(read=None):
    """Walks up the parent processes until it finds Claude Code.

    Only runs once per session: the pid is kept in the session file afterwards.
    """
    read = read or proc_reader()
    pid = os.getppid()
    for _ in range(8):
        if pid <= 1:
            break
        comm, exe, ppid = read(pid)
        if "claude" in comm.lower() or "/claude/" in exe:
            return pid
        if not ppid:
            break
        pid = ppid
    return os.getppid()


def replace(tmp, path, tries=10):
    """os.replace, retried: on Windows it fails while a reader has the file open."""
    for i in range(tries):
        try:
            os.replace(tmp, path)
            return
        except PermissionError:
            if i == tries - 1:
                raise
            time.sleep(0.02)


def main():
    ev = json.load(sys.stdin)
    sid = ev.get("session_id")
    if not sid:
        return
    path = os.path.join(STATE_DIR, f"claude-{sid}.json")

    prev = {}
    try:
        with open(path) as f:
            prev = json.load(f)
    except (OSError, ValueError):
        pass

    name = ev.get("hook_event_name", "")
    state, detail = map_event(ev, prev.get("state"))
    subagents = update_subagents(name, ev, prev.get("subagents"))
    if state is None:
        if subagents == (prev.get("subagents") or []) or not prev:
            return
        state, detail = prev.get("state", "working"), prev.get("detail", "")

    now = time.time()

    # Turn time: starts with the prompt and ends with Stop/StopFailure.
    turn_started, turn_ended = prev.get("turn_started"), prev.get("turn_ended")
    if name == "UserPromptSubmit":
        turn_started, turn_ended = now, None
    elif name in ("Stop", "StopFailure"):
        turn_ended = now

    # Context in use: re-read from the transcript on the events that change it.
    tokens, model = prev.get("tokens"), prev.get("model")
    if name in ("Stop", "StopFailure", "PostToolUse", "PostToolUseFailure", "SessionStart"):
        t, m = context_usage(ev.get("transcript_path"))
        if t is not None:
            tokens, model = t, m or model
    elif name == "PostCompact":
        tokens = None   # unknown until the next response
    cwd = ev.get("cwd") or prev.get("cwd") or ""
    agent_pid = prev.get("pid") or find_agent_pid()
    data = {
        "v": 1,
        "agent": "claude",
        "id": sid,
        "state": state,
        "detail": detail or "",
        "cwd": cwd,
        "project": project_name(cwd),
        "pid": agent_pid,
        "mux": prev.get("mux") or mux_info(),
        "term": prev.get("term") or term_info(agent_pid),
        "turn_started": turn_started,
        "turn_ended": turn_ended,
        "tokens": tokens,
        "model": model,
        "subagents": subagents,
        "started": prev.get("started") or now,
        "since": now if prev.get("state") != state else prev.get("since", now),
        "updated": now,
    }

    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        json.dump(data, f)
    replace(tmp, path)


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
    sys.exit(0)
